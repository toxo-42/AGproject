<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PeOb.Card.Dialog"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="@dimen/space_lg">

    <TextView
        android:text="음성 안내 설정"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_lg"/>

    <TextView
        android:text="목소리 성별 선택"
        android:textAppearance="@style/TextAppearance.PeOb.FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"/>

    <RadioGroup
        android:id="@+id/rgGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_lg">

      <RadioButton
          android:id="@+id/rbFemale"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="wrap_content"
          android:text="여성"
          android:textAppearance="?attr/textAppearanceBodyLarge"
          android:textColor="?attr/colorOnSurface"
          android:checked="true"/>

      <RadioButton
          android:id="@+id/rbMale"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="wrap_content"
          android:text="남성"
          android:textAppearance="?attr/textAppearanceBodyLarge"
          android:textColor="?attr/colorOnSurface"/>
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
          android:id="@+id/btnTestTTS"
          style="@style/Widget.PeOb.Button.Tonal"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="@dimen/button_height"
          android:layout_marginEnd="@dimen/space_sm"
          android:text="들어보기"/>

      <com.google.android.material.button.MaterialButton
          android:id="@+id/btnClose"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="@dimen/button_height"
          android:text="저장 &amp; 닫기"/>
    </LinearLayout>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
