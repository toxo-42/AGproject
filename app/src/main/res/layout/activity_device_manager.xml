<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/space_xl">

  <!-- 상단 바: 제목 · 기록 내보내기 · 기록 삭제 · 음성 설정 -->
  <LinearLayout
      android:id="@+id/layoutHeader"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent">

    <TextView
        android:text="@string/title_manager"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"/>

    <!-- 로깅 데이터 추출(Phase E) — filesDir/logs 의 원시/이벤트 CSV를 시스템 공유 시트로 내보낸다 -->
    <ImageButton
        android:id="@+id/btnExportLogs"
        style="@style/Widget.PeOb.IconButton"
        android:src="@drawable/ic_download"
        android:contentDescription="@string/desc_export_logs" />

    <!-- 주행 기록 삭제 — 계속 쌓이기만 하는 filesDir/logs를 앱 안에서 정리할 수 있게 -->
    <ImageButton
        android:id="@+id/btnDeleteLogs"
        style="@style/Widget.PeOb.IconButton"
        android:src="@drawable/ic_delete"
        app:tint="?attr/colorError"
        android:contentDescription="@string/desc_delete_logs" />

    <ImageButton
        android:id="@+id/btnOpenSettings"
        style="@style/Widget.PeOb.IconButton"
        android:src="@drawable/ic_volume_up"
        android:contentDescription="Settings" />
  </LinearLayout>

  <!-- 기기 정보 (읽기 전용) -->
  <LinearLayout
      android:id="@+id/layoutInfo"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginTop="@dimen/space_xl"
      app:layout_constraintTop_toBottomOf="@id/layoutHeader">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_device_name"
        android:textAppearance="@style/TextAppearance.PeOb.FieldLabel"
        android:layout_marginBottom="@dimen/space_sm"/>

    <EditText
        android:id="@+id/etDeviceName"
        style="@style/Widget.PeOb.ValueField"
        android:text="@string/default_module_name"
        android:inputType="none"
        android:focusable="false"
        android:importantForAutofill="no"
        android:clickable="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/label_mac_address"
        android:textAppearance="@style/TextAppearance.PeOb.FieldLabel"
        android:layout_marginBottom="@dimen/space_sm"/>

    <EditText
        android:id="@+id/etMacAddress"
        style="@style/Widget.PeOb.ValueField"
        android:text="@string/default_mac"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:fontFamily="monospace"
        android:inputType="none"
        android:focusable="false"
        android:importantForAutofill="no"
        android:clickable="false"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/label_status"
        android:textAppearance="@style/TextAppearance.PeOb.FieldLabel"
        android:layout_marginBottom="@dimen/space_sm"/>

    <!-- 글자색은 DeviceManagerActivity가 연결 상태에 따라 바꾼다 -->
    <TextView
        android:id="@+id/tvConnectionStatus"
        style="@style/Widget.PeOb.ValueField"
        android:text="@string/status_monitoring"
        android:textStyle="bold"/>

  </LinearLayout>

  <!-- 데이터 수집 화면 진입 (Phase A: 실시간 그래프 + 라벨링) -->
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnDataCollect"
      android:layout_width="match_parent"
      android:layout_height="@dimen/button_height_large"
      android:layout_marginBottom="@dimen/space_sm"
      android:text="@string/btn_data_collect"
      app:layout_constraintBottom_toTopOf="@id/btnDisconnect"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnDisconnect"
      style="@style/Widget.PeOb.Button.Outlined.Danger"
      android:layout_width="match_parent"
      android:layout_height="@dimen/button_height_large"
      android:layout_marginBottom="@dimen/space_xxl"
      android:text="@string/btn_disconnect"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
