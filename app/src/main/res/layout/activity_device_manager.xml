<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

  <LinearLayout
      android:id="@+id/layoutHeader"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layout_marginTop="28dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent">

    <TextView
        android:text="@string/title_manager"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"/>

    <!-- 로깅 데이터 추출(Phase E) — filesDir/logs 의 원시/이벤트 CSV를 시스템 공유 시트로 내보낸다 -->
    <ImageButton
        android:id="@+id/btnExportLogs"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_save"
        app:tint="@color/text_white"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:contentDescription="@string/desc_export_logs" />

    <!-- 주행 기록 삭제 — 계속 쌓이기만 하는 filesDir/logs를 앱 안에서 정리할 수 있게 -->
    <ImageButton
        android:id="@+id/btnDeleteLogs"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/red_error"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:contentDescription="@string/desc_delete_logs" />

    <ImageButton
        android:id="@+id/btnOpenSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"

        android:src="@drawable/tts_setting_img"

        android:background="?attr/selectableItemBackgroundBorderless"

        android:scaleType="fitCenter"
        android:padding="8dp"
        android:contentDescription="Settings" />
  </LinearLayout>


  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginTop="30dp"
      app:layout_constraintTop_toBottomOf="@id/layoutHeader">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_device_name"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etDeviceName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/bg_card"
        android:text="@string/default_module_name"
        android:textColor="@color/text_white"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"
        android:inputType="none"
        android:focusable="false"
        android:importantForAutofill="no"
        android:clickable="false" />

    <View android:layout_width="match_parent" android:layout_height="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_mac_address"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etMacAddress"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/bg_card"
        android:text="@string/default_mac"
        android:textColor="@color/text_gray"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"
        android:inputType="none"
        android:focusable="false"
        android:importantForAutofill="no"
        android:clickable="false"/>

    <View android:layout_width="match_parent" android:layout_height="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_status"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/bg_card"
        android:text="@string/status_monitoring"
        android:textColor="@color/text_white"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"/>

  </LinearLayout>

  <!-- 데이터 수집 화면 진입 (Phase A: 실시간 그래프 + 라벨링) -->
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnDataCollect"
      android:layout_width="match_parent"
      android:layout_height="60dp"
      android:text="@string/btn_data_collect"
      android:backgroundTint="@color/bg_dark"
      android:textColor="@color/accent_blue"
      app:strokeColor="@color/accent_blue"
      app:strokeWidth="2dp"
      app:cornerRadius="12dp"
      android:layout_marginHorizontal="16dp"
      android:layout_marginBottom="16dp"
      app:layout_constraintBottom_toTopOf="@id/btnDisconnect"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnDisconnect"
      android:layout_width="match_parent"
      android:layout_height="60dp"
      android:text="@string/btn_disconnect"
      android:backgroundTint="@color/bg_dark"
      android:textColor="@color/red_error"
      app:strokeColor="@color/red_error"
      app:strokeWidth="2dp"
      app:cornerRadius="12dp"
      android:layout_marginHorizontal="16dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      android:layout_marginBottom="70dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>