<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingTop="@dimen/space_xl"
    android:paddingBottom="@dimen/space_md">

    <TextView
        android:id="@+id/tvCollectTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="@string/title_data_collect"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 개발자 전용 페르소나 선택(없음/초보/평범/난폭) — dev mode 에서만 보인다.
         버튼은 DataCollectActivity 가 Persona 목록으로 채운다 -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/togglePersona"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:visibility="gone"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/tvCollectTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 현재 압력값 (숫자) -->
    <TextView
        android:id="@+id/tvLiveValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_value_field"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm"
        android:text="@string/live_values_idle"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/togglePersona"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 실시간 그래프 (accel/brake + 임계선) — 카드 안에 넣어 화면 배경과 구분 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGraph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm"
        app:contentPadding="@dimen/space_sm"
        app:layout_constraintTop_toBottomOf="@id/tvLiveValues"
        app:layout_constraintBottom_toTopOf="@id/btnOpenTrial">

        <com.example.agproject.PedalGraphView
            android:id="@+id/graphPedal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- 개발자 전용 안내형 재현 실험 진입(오조작 라벨 자동 기록) — 일반 진입 시 숨김, dev mode 에서만 표시 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenTrial"
        style="@style/Widget.PeOb.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/btn_open_trial"
        android:visibility="gone"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvLegend" />

    <TextView
        android:id="@+id/tvLegend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:paddingHorizontal="@dimen/space_sm"
        android:text="@string/graph_legend"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/btnCalibrate" />

    <!-- 연속형 개인화 캘리브레이션("패턴 파악") — 캘리브레이션 시간 동안 실주행 패턴을 모아 accel_high를 개인화 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalibrate"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:text="@string/btn_calibrate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnResetCalibration"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <!-- 캘리브레이션 초기화 — 삭제 후 재설치한 것처럼 되돌려 다시 패턴 파악하게 한다 -->
    <ImageButton
        android:id="@+id/btnResetCalibration"
        android:layout_width="@dimen/button_height"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/space_sm"
        android:background="@drawable/bg_value_field"
        android:src="@drawable/ic_refresh"
        app:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/desc_reset_calibration"
        app:layout_constraintBottom_toBottomOf="@id/btnCalibrate"
        app:layout_constraintTop_toTopOf="@id/btnCalibrate"
        app:layout_constraintStart_toEndOf="@id/btnCalibrate"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
