<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:background="?attr/colorSurface"
                                                   android:paddingHorizontal="@dimen/space_md"
                                                   android:paddingTop="@dimen/space_xl">

  <!-- 상단 바: 뒤로가기 · 제목 · 검색 중 표시 -->
  <ImageButton
      android:id="@+id/btnBack"
      style="@style/Widget.PeOb.IconButton"
      android:src="@drawable/ic_arrow_back"
      app:tint="?attr/colorOnSurface"
      android:contentDescription="@string/desc_back_button"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <TextView
      android:id="@+id/tvScanTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/space_sm"
      android:text="@string/title_scan"
      android:textAppearance="?attr/textAppearanceTitleLarge"
      android:textColor="?attr/colorOnSurface"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="@id/btnBack"
      app:layout_constraintStart_toEndOf="@id/btnBack"
      app:layout_constraintEnd_toStartOf="@id/progressBar"
      app:layout_constraintTop_toTopOf="@id/btnBack" />

  <ProgressBar
      android:id="@+id/progressBar"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginEnd="@dimen/space_md"
      android:indeterminateTint="?attr/colorPrimary"
      app:layout_constraintBottom_toBottomOf="@id/btnBack"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@id/btnBack" />

  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recyclerView"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="@dimen/space_md"
      android:clipToPadding="false"
      android:paddingHorizontal="@dimen/space_sm"
      android:paddingBottom="@dimen/space_lg"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toBottomOf="@id/btnBack" />

</androidx.constraintlayout.widget.ConstraintLayout>
